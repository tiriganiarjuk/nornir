{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zone-request",
  "description": "What write_json_validate_zone is handed: every file the zone is to hold, by its path relative to the zone root. A text entry is validated against its named schema and written in its format; a copy entry is the bytes of an existing file, as they are. Every file not listed is gone after the write.",
  "type": "object",
  "required": ["files"],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["path", "format", "schema_name", "data"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "format": {"enum": ["json", "toml", "yaml", "toon", "xml", "markdown"]},
              "schema_name": {"type": "string", "minLength": 1},
              "data": {}
            }
          },
          {
            "type": "object",
            "required": ["path", "from"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "from": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  }
}
